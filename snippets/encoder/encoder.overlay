// Placeholder EC11 node — no hardware connected.
// Required by zmk,keymap-sensors for DTS binding validation.
// On Central, DEVICE_DT_GET_OR_NULL returns NULL and initialization is skipped.
/ {
    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <12>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <6>;
    };
};
