// Left peripheral encoder overlay.
// J101逆向き接続: A=GPIO0.16(SDIO), B=GPIO0.19(MOTION)
// SW: GPIO0.20をgpio-hogでOUTPUT HIGH固定、GPIO0.18をkscan-gpio-directで検出。
// idle時もGPIO0.20がHIGHなのでSW押下で即座に割り込みが発生する。
// SPI0/I2C0を無効化してGPIO0.16/0.18/0.20を解放する。

&spi0 {
    status = "disabled";
};

&i2c0 {
    status = "disabled";
};

// GPIO0.20をSW用の常時HIGH電圧源として設定（kscanドライバに取られる前に設定）
&gpio0 {
    enc_sw_drive: enc_sw_drive {
        gpio-hog;
        gpios = <20 0>;
        output-high;
    };
};

&encoder {
    a-gpios = <&gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    b-gpios = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    status = "okay";
};

/ {
    chosen {
        zmk,kscan = <&kscan_enc_composite>;
    };

    kscan_enc_sw: kscan_enc_sw {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios = <&gpio0 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        wakeup-source;
    };

    kscan_enc_composite: kscan_enc_composite {
        compatible = "zmk,kscan-composite";
        rows = <5>;
        columns = <12>;

        matrix {
            kscan = <&kscan0>;
        };

        enc_sw {
            kscan = <&kscan_enc_sw>;
            row-offset = <4>;
            col-offset = <10>;
        };
    };
};

&physical_layout_s { kscan = <&kscan_enc_composite>; };
&physical_layout_m { kscan = <&kscan_enc_composite>; };
&physical_layout_l { kscan = <&kscan_enc_composite>; };
