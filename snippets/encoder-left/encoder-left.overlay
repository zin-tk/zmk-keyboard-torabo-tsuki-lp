// Left peripheral encoder overlay.
// J101コネクタが逆向き接続のため:
//   A = GPIO0.20 (CS/pin5), B = GPIO0.19 (MOTION/pin4)
//   SW候補 = GPIO0.16 (SDIO/pin3), GPIO0.18 (SCLK/pin2)
// SPI0/I2C0を無効化してGPIO0.18/16をSW用に解放する。

&spi0 {
    status = "disabled";
};

&i2c0 {
    status = "disabled";
};

&encoder {
    a-gpios = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    b-gpios = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    status = "okay";
};

/ {
    chosen {
        zmk,kscan = <&kscan_enc_composite>;
    };

    kscan_enc_sw: kscan_enc_sw {
        compatible = "zmk,kscan-gpio-direct";
        input-gpios
            = <&gpio0 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
        wakeup-source;
    };

    kscan_enc_composite: kscan_enc_composite {
        compatible = "zmk,kscan-composite";
        rows = <5>;
        columns = <12>;

        matrix {
            kscan = <&kscan0>;
        };

        enc_sw {
            kscan = <&kscan_enc_sw>;
            row-offset = <4>;
            col-offset = <10>;
        };
    };
};

// 各レイアウトのkscanプロパティを削除してzmk,chosen（kscan_enc_composite）を使わせる
&physical_layout_s { /delete-property/ kscan; };
&physical_layout_m { /delete-property/ kscan; };
&physical_layout_l { /delete-property/ kscan; };
