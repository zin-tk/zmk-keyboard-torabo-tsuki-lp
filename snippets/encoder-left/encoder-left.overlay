// Left peripheral encoder overlay.
// J101: A=GPIO0.16(SDIO), B=GPIO0.19(MOTION)
// SW: GPIO0.20(col/drive) -> GPIO0.18(row/sense) kscan-gpio-matrix polling mode.
// polling mode avoids BLE latency/GPIO interrupt timing issues.
// SPI0/I2C0 disabled to free GPIO0.16/0.18/0.20.

&spi0 { status = "disabled"; };
&i2c0 { status = "disabled"; };

&encoder {
    a-gpios = <&gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    b-gpios = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    status = "okay";
};

/ {
    chosen {
        zmk,kscan = <&kscan_enc_composite>;
    };

    kscan_enc_sw: kscan_enc_sw {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        col-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
        row-gpios = <&gpio0 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        poll-period-ms = <10>;
    };

    kscan_enc_composite: kscan_enc_composite {
        compatible = "zmk,kscan-composite";
        rows = <5>;
        columns = <12>;

        matrix {
            kscan = <&kscan0>;
        };

        enc_sw {
            kscan = <&kscan_enc_sw>;
            row-offset = <4>;
            col-offset = <10>;
        };
    };
};

&physical_layout_s { kscan = <&kscan_enc_composite>; };
&physical_layout_m { kscan = <&kscan_enc_composite>; };
&physical_layout_l { kscan = <&kscan_enc_composite>; };
